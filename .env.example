NEXT_PUBLIC_SITE_URL=https://aoupa.online
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

PAID_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
## VPS video files (Docker Compose sets this to /app/data/videos).
## For a Node process outside Docker, use an absolute persistent directory.
VPS_VIDEO_DIR=./data/videos
## Optional independent signing secret; defaults to the server-only Supabase service role key.
VIDEO_UPLOAD_SECRET=
