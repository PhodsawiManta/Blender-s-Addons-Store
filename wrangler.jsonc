{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aoupa",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
